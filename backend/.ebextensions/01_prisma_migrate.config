container_commands:
  01_prisma_migrate:
    command: |
      if [ -z "$DATABASE_URL" ] && [ -x /opt/elasticbeanstalk/bin/get-config ]; then
        export DATABASE_URL="$(/opt/elasticbeanstalk/bin/get-config environment -k DATABASE_URL)"
      fi
      npm run db:migrate:deploy
    leader_only: true
