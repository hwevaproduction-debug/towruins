{
  "name": "server",
  "version": "1.0.0",
  "description": "Town Ruins Rental Marketplace",
  "main": "server.js",
  "scripts": {
    "prestart": "prisma generate",
    "start": "node server.js",
    "postinstall": "prisma generate",
    "server": "nodemon server.js",
    "s3:cors": "node scripts/configure-s3-cors.js",
    "db:migrate:deploy": "prisma migrate deploy",
    "seed": "node seed/seed.js",
    "seed:db": "node seed/seed-direct.js",
    "seed:amenities": "node seed/seed-amenities.js",
    "seed:legal": "node seed/seed-legal-docs.js",
    "seed:super-admin": "node seed/seed-super-admin.js",
    "build": "npm install --legacy-peer-deps && cd ../frontend && npm install --legacy-peer-deps && npm run build",
    "test:home-feeds": "node --test tests/listingHomeFeeds.test.js",
    "test:monetization": "node --test tests/monetizationRules.test.js",
    "test:unit": "node --test tests/*.test.js",
    "test:e2e": "node tests/e2e/runner.js"
  },
  "author": "Alvin Phiri",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.978.0",
    "@aws-sdk/s3-request-presigner": "^3.978.0",
    "@prisma/client": "^5.0.0",
    "africastalking": "^0.8.0",
    "bcryptjs": "^2.4.3",
    "colors": "^1.4.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.0.0",
    "express-validator": "^7.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "node-cron": "^3.0.0",
    "nodemailer": "^7.0.10",
    "paynow": "^2.0.0",
    "prisma": "^5.0.0",
    "stripe": "^14.0.0",
    "validator": "^13.11.0"
  }
}
