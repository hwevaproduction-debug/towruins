FROM node:20-slim AS build
WORKDIR /app
ENV CI=true
ARG REACT_APP_API_URL
ARG REACT_APP_BACKEND_URL
ARG REACT_APP_FIREBASE_API_KEY
ARG REACT_APP_TOKEN_PAYER_ROLE
ARG REACT_APP_LISTING_FEE_AMOUNT
ARG REACT_APP_TENANT_PREMIUM_AMOUNT
ENV REACT_APP_API_URL=$REACT_APP_API_URL
ENV REACT_APP_BACKEND_URL=$REACT_APP_BACKEND_URL
ENV REACT_APP_FIREBASE_API_KEY=$REACT_APP_FIREBASE_API_KEY
ENV REACT_APP_TOKEN_PAYER_ROLE=$REACT_APP_TOKEN_PAYER_ROLE
ENV REACT_APP_LISTING_FEE_AMOUNT=$REACT_APP_LISTING_FEE_AMOUNT
ENV REACT_APP_TENANT_PREMIUM_AMOUNT=$REACT_APP_TENANT_PREMIUM_AMOUNT

COPY package*.json ./
RUN npm ci --legacy-peer-deps

COPY . .
RUN npm run build

FROM nginx:stable-alpine

COPY --from=build /app/build /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
